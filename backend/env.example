BASE_URL=http://localhost:4200

# Discord Configuration
DISCORD=1
DISCORD_CLIENT_ID=
DISCORD_BOT_TOKEN=

# Nonce expiry (5 minutes)
NONCE_EXPIRY=300000

# Dynamic Role Management
# CRON expression for role re-verification (default: every 6 hours)
# You can use either:
# 1. Predefined values: EVERY_6_HOURS, EVERY_12_HOURS, EVERY_DAY_AT_MIDNIGHT, EVERY_4_HOURS
# 2. Custom CRON expressions: 0 */6 * * *, */30 * * * *, etc.
# Examples:
# - Every 6 hours: EVERY_6_HOURS or 0 */6 * * *
# - Every 12 hours: EVERY_12_HOURS or 0 */12 * * *
# - Daily at midnight: EVERY_DAY_AT_MIDNIGHT or 0 0 * * *
# - Every 4 hours: EVERY_4_HOURS or 0 */4 * * *
# - Every 30 minutes: */30 * * * *
DYNAMIC_ROLE_CRON=EVERY_6_HOURS

# Data Service Supabase (Ethscriptions data)
DATA_SUPABASE_URL=
DATA_SUPABASE_ANON_KEY=

# DB Service Supabase (Application database)
DB_SUPABASE_URL=
# Backend service-role key; public keys cannot read or modify wallet restrictions.
DB_SUPABASE_KEY=

# Full Ethereum mainnet RPC URL for NFT checks
RPC_URL=
# Full Robinhood mainnet RPC URL; required only for Robinhood NFT rules.
# Alchemy: https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY
ROBINHOOD_RPC_URL=
# NFT traits use the Alchemy key from each network's RPC URL by default.
# Optional separate key when using another RPC provider; enable both networks in Alchemy.
ALCHEMY_API_KEY=

# Ordinals API provider: xverse (default) or ordnet. Xverse wallet signing stays the same.
ORDINALS_PROVIDER=xverse
# Xverse Ordinals API key; required when using the default provider. Backend only.
XVERSE_API_KEY=
# Optional one-hour ord.net session token for manual tests; takes precedence over auto login.
ORDNET_SESSION_TOKEN=
# Dedicated ord.net API wallet for automatic login/renewal. Backend only.
# Payment address must hold at least 0.001 BTC confirmed. Keys are compressed mainnet WIF.
# yarn ordnet:wallet creates these in the private, gitignored .env.ordnet file.
ORDNET_ORDINALS_ADDRESS=
ORDNET_PAYMENT_ADDRESS=
ORDNET_ORDINALS_WIF=
# Optional when the payment address uses a different key; defaults to ORDNET_ORDINALS_WIF.
ORDNET_PAYMENT_WIF=
