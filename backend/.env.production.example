# Production environment configuration
BASE_URL=https://your-production-domain.com

# Discord Configuration
DISCORD=1
DISCORD_CLIENT_ID=your-production-discord-client-id
DISCORD_CLIENT_SECRET=your-production-discord-client-secret
DISCORD_BOT_TOKEN=your-production-discord-bot-token

# Nonce expiry (5 minutes)
NONCE_EXPIRY=300000

# Data Service Supabase (Ethscriptions data)
DATA_SUPABASE_URL=https://kcbuycbhynlmsrvoegzp.supabase.co
DATA_SUPABASE_ANON_KEY=your-data-service-anon-key

# DB Service Supabase (Application database)
DB_SUPABASE_URL=https://cpwubaszhjdtqlvfdlbx.supabase.co
DB_SUPABASE_KEY=your-db-service-key
# Full Ethereum mainnet RPC URL; required when adding NFT rules.
RPC_URL=
# Full Robinhood mainnet RPC URL; required only for Robinhood NFT rules.
ROBINHOOD_RPC_URL=
# Ordinals collection source: xverse (default) or ordnet (persistent collection catalog).
ORDINALS_PROVIDER=xverse
# Xverse Ordinals API key; required when using the default provider. Backend only.
XVERSE_API_KEY=
# Fresh ownership lookup order. Missing keys and providers in cooldown are skipped.
ORDINALS_OWNERSHIP_PROVIDERS=ordiscan,subfrost,sandshrew,xverse
ORDISCAN_API_KEY=
SANDSHREW_API_KEY=
# SUBFROST uses its public endpoint; no key is needed. Sandshrew uses /v1/.
# Dedicated ord.net API wallet. Payment address needs at least 0.001 BTC confirmed.
ORDNET_ORDINALS_ADDRESS=
ORDNET_PAYMENT_ADDRESS=
ORDNET_ORDINALS_WIF=
# Optional separate payment key; otherwise the Ordinals key is used for both addresses.
ORDNET_PAYMENT_WIF=
# Optional manual token instead of wallet login; expires after one hour.
ORDNET_SESSION_TOKEN=

# Backend-only: explicitly appointed Bouncer Operators (numeric Discord user IDs).
# Comma/whitespace separated; empty appoints nobody. Configure manually in Railway.
BOUNCER_OPERATOR_DISCORD_IDS=
